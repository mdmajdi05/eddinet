{
  "name": "eddinet-web",
  "version": "1.0.0",
  "private": true,
  "description": "Eddinet digital marketing and software agency website.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "serve": "node scripts/serve-standalone.mjs",
    "check:site": "node ../site-checker/bin/check.mjs --config site-checker.config.json",
    "typecheck": "tsc --noEmit",
    "images:download": "node scripts/download-remote-images.mjs",
    "images:check": "node scripts/check-images.mjs",
    "images:optimize": "node scripts/optimize-images.mjs",
    "check": "npm run typecheck && npm run images:check"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "autoprefixer": "^10.5.4",
    "lucide-react": "^1.34.0",
    "next": "^15.3.5",
    "postcss": "^8.5.26",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "sharp": "^0.34.5",
    "typescript": "^5.8.3"
  }
}
